# Copiar a .env si necesitas personalizar la configuración.
# Se conserva la configuración del login y del listado de perfiles existentes.
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# En desarrollo la demostración está habilitada por defecto.
# true: ofrece el botón de demo también en un build de demostración.
# false: oculta la demo. En producción se oculta si no se define esta variable.
# La demo solo se activa mediante su botón; nunca por fallos del servicio real.
# VITE_DEMO=false

# VITE_GRUPOS_MOCK y VITE_FORZAR_ADMIN ya no controlan las pantallas nuevas.
# Solo un perfil autenticado con is_admin=true habilita la administración.
# La conexión del panel se completa en src/api/panelReal.ts.
