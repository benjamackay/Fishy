# Plantilla de variables de entorno. Copiar a `.env` (que NO se commitea).

# URL base de la API. En desarrollo se deja en /api para que Vite la redirija
# al backend local mediante el proxy de vite.config.ts.
# En producción hay que apuntarla al backend real, p.ej. https://api.fishy.cl/api
VITE_API_URL=/api

# Destino del proxy de desarrollo. Solo se usa cuando VITE_API_URL es /api.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Grupos: hoy los sirve un mock local porque el backend no los tiene todavia.
# Cuando Django implemente los endpoints de src/types/grupos.ts, poner false.
VITE_GRUPOS_MOCK=true

# El backend no expone `is_admin` en /auth/perfil/, asi que ninguna cuenta se ve
# como administradora desde el frontend. Este flag deja entrar al panel de
# grupos mientras tanto. Quitar cuando el backend exponga el campo.
VITE_FORZAR_ADMIN=true
