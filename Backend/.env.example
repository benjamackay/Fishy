# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# El `.env` real NO se commitea (está en .gitignore).

# ─── Base de datos: Supabase (Postgres administrado) ──────────────────────────
# El host se deriva de la URL del proyecto Supabase:
#   URL API : https://<project-ref>.supabase.co
#   Host BD  : db.<project-ref>.supabase.co   <-- este es el que usa Django
# La database password se define en: Supabase > Project Settings > Database.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_database_password
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432

# Reutilización de la conexión, en segundos. Déjalo en 0 mientras se use
# `runserver` (dev). Al desplegar con gunicorn, subirlo a 600 ahorra ~500 ms
# por request (el handshake TLS contra Supabase). Ver settings.py.
DB_CONN_MAX_AGE=0

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
