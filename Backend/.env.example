# Plantilla de Backend/.env — copiala y rellena los valores:
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# El .env real NO se sube al repositorio: lo cubre la regla *.env del
# .gitignore de la raiz. Pide los valores a alguien del equipo por un canal
# privado, nunca por el repo ni por el chat del grupo.

# ── Base de datos (Supabase / Postgres) ──────────────────────────────────────
# USA EL POOLER, NO LA CONEXION DIRECTA. El host directo
# (db.<ref>.supabase.co) hoy publica SOLO IPv6, asi que en una red sin IPv6
# —la mayoria de las caseras en Chile— falla con "could not translate host
# name ... Name or service not known". El pooler si tiene IPv4.
#   DB_HOST=aws-0-<region>.pooler.supabase.com   (este proyecto: sa-east-1)
#   DB_USER=postgres.<ref-del-proyecto>          (ojo: lleva el ref pegado)
#   DB_PORT=5432                                 (modo sesion; el 6543 es transaccion)
# El string exacto sale del panel: Project Settings -> Database -> Connection
# string -> Session pooler.
DB_NAME=postgres
DB_USER=postgres.<ref-del-proyecto>
DB_PASSWORD=
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
# Supabase exige SSL.
DB_SSLMODE=require
# Segundos que se reutiliza una conexion. 0 = abrir una por request.
DB_CONN_MAX_AGE=

# ── Django ───────────────────────────────────────────────────────────────────
# Generala con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True solo en desarrollo. En cualquier equipo que exponga el backend: False.
DJANGO_DEBUG=True
